@model Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
    var hasInvoice = !string.IsNullOrWhiteSpace(Model.InvoiceFkey) && Model.InvoiceStatus != InvoiceStatuses.NotIssued;
    var canRecordRefund = EcommerceApp.Services.OrderLifecycle.CanRecordManualRefund(Model);
    var isCod = string.Equals(Model.PaymentMethod, "COD", StringComparison.OrdinalIgnoreCase);
    var refundLabel = canRecordRefund && Model.RefundStatus == RefundStatuses.NotRequired
        ? "Chưa ghi nhận hoàn tiền" : Model.RefundStatus;
}

<section class="admin-grid">
    <div class="admin-panel">
        <div class="panel-head">
            <h2>Thông tin đơn hàng</h2>
            <a class="admin-button secondary" href="/Admin/Order/Print/@Model.Id" target="_blank" rel="noopener">In phiếu</a>
        </div>
        <dl class="detail-list">
            <dt>Khách hàng</dt><dd>@Model.User?.FullName (@Model.User?.Email)</dd>
            <dt>Người nhận</dt><dd>@Model.RecipientName - @Model.RecipientPhone</dd>
            <dt>Địa chỉ</dt><dd>@Model.ShippingAddress</dd>
            <dt>Thanh toán</dt><dd>@Model.PaymentMethod</dd>
            <dt>Trạng thái thanh toán</dt><dd><span class="admin-pill @(Model.IsPaid ? "success" : "warning")">@(Model.IsPaid ? isCod ? "Đã thu COD khi giao" : "VNPAY đã thanh toán" : isCod ? "Chưa thu COD" : "Chưa thanh toán")</span></dd>
            @if (Model.PaidAt.HasValue)
            {
                <dt>Thanh toán lúc</dt><dd>@Model.PaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            }
            <dt>Hoàn tiền</dt><dd><span class="admin-pill @(Model.RefundStatus == RefundStatuses.PendingManual || Model.RefundStatus == RefundStatuses.Refunded && Model.RefundReceiptStatus != ReceiptStatuses.Confirmed ? "warning" : Model.RefundStatus == RefundStatuses.Refunded ? "success" : "")">@(Model.RefundStatus == RefundStatuses.Refunded ? "Shop ghi nhận đã chuyển tiền hoàn" : refundLabel)</span></dd>
            @if (Model.RefundRequestedAt.HasValue)
            {
                <dt>Yêu cầu hoàn</dt><dd>@Model.RefundRequestedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            }
            @if (Model.RefundedAt.HasValue)
            {
                <dt>Shop ghi nhận chuyển lúc</dt><dd>@Model.RefundedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            }
            @if (Model.RefundAmount.HasValue)
            {
                <dt>Số tiền shop ghi nhận chuyển</dt><dd>@Model.RefundAmount.Value.ToString("N0") ₫</dd>
                <dt>Kênh đã hoàn</dt><dd>@Model.RefundMethod</dd>
                <dt>Mã đối soát</dt><dd>@Model.RefundReference</dd>
                <dt>Người xác nhận</dt><dd>@Model.RefundConfirmedBy</dd>
            }
            @if (Model.RefundStatus == RefundStatuses.Refunded)
            {
                <dt>Khách xác nhận tiền về</dt><dd>@Model.RefundReceiptStatus</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.RefundNote))
            {
                <dt>Ghi chú hoàn tiền</dt><dd>@Model.RefundNote</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.VoucherCode) || Model.DiscountAmount > 0)
            {
                <dt>Mã giảm giá</dt><dd>@(string.IsNullOrWhiteSpace(Model.VoucherCode) ? "Không có" : Model.VoucherCode) (-@Model.DiscountAmount.ToString("N0") ₫)</dd>
            }
            <dt>Phí vận chuyển</dt><dd>@Model.ShippingFee.ToString("N0") ₫</dd>
            <dt>Tổng tiền</dt><dd>@Model.TotalAmount.ToString("N0") ₫</dd>
        </dl>
        <form asp-action="UpdateStatus" method="post" class="inline-form">
            <input type="hidden" name="id" value="@Model.Id" />
            <select name="status" aria-label="Trạng thái đơn hàng">
                @foreach (var status in OrderStatuses.All.Where(status => EcommerceApp.Services.OrderLifecycle.CanTransition(Model, status)))
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
            <button class="admin-button" type="submit">Cập nhật trạng thái</button>
        </form>
        @if (canRecordRefund)
        {
            <details class="admin-refund" open="@(Model.RefundStatus == RefundStatuses.PendingManual)">
                <summary>Ghi nhận khoản đã chuyển hoàn thủ công</summary>
            <form asp-action="MarkRefunded" method="post" class="stack-form admin-refund-form">
                <input type="hidden" name="id" value="@Model.Id" />
                <p class="form-hint">@(isCod ? "Hoàn tiền cho khách bằng chuyển khoản ngân hàng hoặc tiền mặt trước, sau đó lưu thông tin đối soát tại đây." : "Thực hiện hoàn tiền qua VNPAY, chuyển khoản ngân hàng hoặc tiền mặt trước, sau đó lưu thông tin đối soát tại đây.")</p>
                <div class="refund-amount">Số tiền ghi nhận hoàn <strong>@Model.TotalAmount.ToString("N0") ₫</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.VnpayTransactionId))
                {
                    <p class="form-hint">Mã giao dịch thanh toán gốc: @Model.VnpayTransactionId</p>
                }
                <label for="refund-method">Kênh đã hoàn tiền</label>
                <select id="refund-method" name="method" required>
                    <option value="">Chọn kênh đã hoàn tiền</option>
                    @foreach (var method in ManualRefundMethods.ForPaymentMethod(Model.PaymentMethod))
                    {
                        <option value="@method">@method</option>
                    }
                </select>
                <label for="refund-reference">Mã giao dịch hoàn tiền / mã biên nhận</label>
                <input id="refund-reference" name="reference" required maxlength="120" autocomplete="off" />
                <label for="refund-note">Lý do hoàn tiền và ghi chú đối soát@(Model.Status == OrderStatuses.Delivered ? " (bắt buộc)" : "")</label>
                <textarea id="refund-note" name="note" rows="3" maxlength="500" required="@(Model.Status == OrderStatuses.Delivered)" placeholder="Lý do hoàn tiền và thông tin để đối soát"></textarea>
                <label class="check-row"><input type="checkbox" name="confirmed" value="true" required /> Tôi xác nhận đã hoàn đủ @Model.TotalAmount.ToString("N0") ₫ cho khách hàng.</label>
                <button class="admin-button" type="submit">Ghi nhận đã chuyển tiền hoàn</button>
            </form>
            </details>
        }
        else if (isCod && !Model.IsPaid && Model.Status != OrderStatuses.Cancelled)
        {
            <p class="form-hint">COD chưa thu tiền nên chưa có khoản để hoàn. Mục ghi nhận hoàn tiền sẽ mở khi đơn đã giao thành công và đã thu tiền.</p>
        }
    </div>
    <div class="admin-panel admin-assurance-panel">
        <div class="panel-head"><h2>Xác nhận giao dịch</h2></div>
        @if (Model.Status == OrderStatuses.Delivered)
        {
            <div class="admin-assurance-block">
                <div class="admin-assurance-line"><strong>Khách nhận hàng</strong><span class="admin-pill @(Model.CustomerReceiptStatus == ReceiptStatuses.Issue ? "danger" : Model.CustomerReceiptStatus == ReceiptStatuses.Confirmed ? "success" : "warning")">@Model.CustomerReceiptStatus</span></div>
                <p>Trạng thái giao thành công và xác nhận của khách được theo dõi riêng.</p>
                @if (Model.CustomerReceiptConfirmedAt.HasValue)
                {
                    <p>Khách xác nhận lúc @Model.CustomerReceiptConfirmedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.DeliveryProofUrl))
                {
                    <a href="@Model.DeliveryProofUrl" target="_blank" rel="noopener noreferrer">Xem chứng từ giao hàng</a>
                }
                <form asp-action="RecordDeliveryProof" method="post" class="stack-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="delivery-proof">Liên kết HTTPS tới chứng từ giao hàng</label>
                    <input id="delivery-proof" name="url" type="url" value="@Model.DeliveryProofUrl" maxlength="500" required />
                    <button class="admin-button secondary" type="submit">Lưu chứng từ</button>
                </form>
                @if (Model.CustomerReceiptStatus == ReceiptStatuses.Issue)
                {
                    <p class="admin-assurance-issue"><strong>Khách báo:</strong> @Model.CustomerReceiptIssue</p>
                    <form asp-action="ResolveDeliveryIssue" method="post" class="stack-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label for="delivery-resolution">Phản hồi sau khi kiểm tra</label>
                        <textarea id="delivery-resolution" name="note" maxlength="500" rows="3" required></textarea>
                        <button class="admin-button" type="submit">Gửi phản hồi và mở xác nhận lại</button>
                    </form>
                }
            </div>
        }
        @if (isCod && Model.Status == OrderStatuses.Delivered)
        {
            <div class="admin-assurance-block">
                <div class="admin-assurance-line"><strong>Tiền COD về shop</strong><span class="admin-pill @(Model.CodSettledAt.HasValue ? "success" : "warning")">@(Model.CodSettledAt.HasValue ? "Shop đã ghi nhận đối soát" : "Chờ đối soát")</span></div>
                @if (Model.CodSettledAt.HasValue)
                {
                    <p>@Model.CodSettlementAmount?.ToString("N0") ₫ · @Model.CodSettlementReference · @Model.CodSettledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                }
                else
                {
                    <p>Chỉ ghi nhận sau khi kiểm tra tiền thực nhận và mã phiên đối soát GHN.</p>
                    <form asp-action="RecordCodSettlement" method="post" class="stack-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label for="cod-settlement-amount">Số tiền shop thực nhận (₫)</label>
                        <input id="cod-settlement-amount" name="amount" type="number" min="1" max="@decimal.Truncate(Model.TotalAmount).ToString(System.Globalization.CultureInfo.InvariantCulture)" step="1" required />
                        <label for="cod-settlement-reference">Mã phiên đối soát / sao kê</label>
                        <input id="cod-settlement-reference" name="reference" maxlength="120" required />
                        <button class="admin-button" type="submit">Ghi nhận đã nhận COD</button>
                    </form>
                }
            </div>
        }
        @if (Model.RefundStatus == RefundStatuses.Refunded)
        {
            <div class="admin-assurance-block">
                <div class="admin-assurance-line"><strong>Khách nhận tiền hoàn</strong><span class="admin-pill @(Model.RefundReceiptStatus == ReceiptStatuses.Issue ? "danger" : Model.RefundReceiptStatus == ReceiptStatuses.Confirmed ? "success" : "warning")">@Model.RefundReceiptStatus</span></div>
                @if (Model.RefundReceiptConfirmedAt.HasValue)
                {
                    <p>Khách xác nhận lúc @Model.RefundReceiptConfirmedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</p>
                }
                @if (Model.RefundReceiptStatus == ReceiptStatuses.Issue)
                {
                    <p class="admin-assurance-issue"><strong>Khách báo:</strong> @Model.RefundReceiptIssue</p>
                    <form asp-action="ResolveRefundIssue" method="post" class="stack-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label for="refund-resolution">Phản hồi sau khi đối soát</label>
                        <textarea id="refund-resolution" name="note" maxlength="500" rows="3" required></textarea>
                        <button class="admin-button" type="submit">Gửi phản hồi và mở xác nhận lại</button>
                    </form>
                }
            </div>
        }
        @if (Model.AssuranceEvents.Any())
        {
            <div class="admin-assurance-block">
                <strong>Lịch sử xác nhận</strong>
                <ol class="admin-assurance-history">
                    @foreach (var entry in Model.AssuranceEvents.OrderByDescending(entry => entry.CreatedAt))
                    {
                        <li><strong>@entry.Type</strong><time>@entry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                            @if (!string.IsNullOrWhiteSpace(entry.Detail)) { <small>@entry.Detail</small> }
                        </li>
                    }
                </ol>
            </div>
        }
    </div>
    <div class="admin-panel">
        <div class="panel-head">
            <h2>Vận chuyển</h2>
        </div>
        @if (EcommerceApp.Services.OrderLifecycle.CanShip(Model))
        {
        <form asp-action="AssignShipping" method="post" class="stack-form">
            <input type="hidden" name="id" value="@Model.Id" />
            <label for="shipping-carrier">Đơn vị vận chuyển</label>
            <input id="shipping-carrier" name="carrier" value="@ShippingCarriers.Ghn" readonly />
            <label for="tracking-code">Mã vận đơn</label>
            <input id="tracking-code" name="trackingCode" value="@Model.ShippingInfo?.TrackingCode" maxlength="80" />
            <label for="estimated-delivery">Dự kiến giao</label>
            <input id="estimated-delivery" type="date" name="estimatedDelivery" value="@Model.ShippingInfo?.EstimatedDelivery?.ToString("yyyy-MM-dd")" />
            <button class="admin-button" type="submit">Lưu vận chuyển</button>
        </form>
        }
        else
        {
            <p>Chỉ gán vận chuyển khi đơn đã được xác nhận và đủ điều kiện thanh toán.</p>
        }
    </div>
    <div class="admin-panel">
        <div class="panel-head">
            <h2>Hóa đơn nội bộ</h2>
            <span class="admin-pill @(Model.InvoiceStatus == InvoiceStatuses.Error ? "warning" : Model.InvoiceStatus == InvoiceStatuses.Cancelled ? "off" : Model.InvoiceStatus == InvoiceStatuses.NotIssued ? "off" : "success")">@Model.InvoiceStatus</span>
        </div>
        <dl class="detail-list">
            <dt>Loại hóa đơn</dt><dd>@(Model.InvoiceProvider ?? "Hóa đơn mô phỏng")</dd>
            <dt>Mã hóa đơn</dt><dd>@(Model.InvoiceFkey ?? $"LOCAL-DH{Model.Id:D6}")</dd>
            <dt>Số hóa đơn</dt><dd>@(Model.InvoiceNumber ?? "Chưa có")</dd>
            <dt>Mã tra cứu</dt><dd>@(Model.InvoiceLookupCode ?? "Chưa có")</dd>
            @if (Model.InvoiceIssuedAt.HasValue)
            {
                <dt>Đã xuất lúc</dt><dd>@Model.InvoiceIssuedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            }
            @if (Model.InvoiceSyncedAt.HasValue)
            {
                <dt>Cập nhật lúc</dt><dd>@Model.InvoiceSyncedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.InvoiceErrorMessage))
            {
                <dt>Lỗi gần nhất</dt><dd>@Model.InvoiceErrorMessage</dd>
            }
        </dl>
        <div class="table-actions">
            <form asp-action="IssueInvoice" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="admin-button" type="submit" disabled="@(hasInvoice && Model.InvoiceStatus != InvoiceStatuses.Error)">Xuất hóa đơn PDF</button>
            </form>
            <form asp-action="DownloadInvoicePdf" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="admin-button secondary" type="submit" disabled="@(!hasInvoice || Model.InvoiceStatus == InvoiceStatuses.Cancelled)">Tải lại PDF</button>
            </form>
            <form asp-action="CancelInvoice" method="post" data-confirm="Huỷ hóa đơn nội bộ của đơn #@Model.Id?">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="admin-button danger" type="submit" disabled="@(!hasInvoice || Model.InvoiceStatus == InvoiceStatuses.Cancelled)">Huỷ hóa đơn</button>
            </form>
        </div>
    </div>
</section>

@if (Model.ReturnWarrantyRequests.Any())
{
    <section class="admin-panel">
        <div class="panel-head"><h2>Yêu cầu đổi trả và bảo hành đã nhận</h2></div>
        @foreach (var request in Model.ReturnWarrantyRequests.OrderByDescending(request => request.CreatedAt))
        {
            <div id="support-request-@request.Id" class="admin-support-summary">
                <div class="panel-head">
                    <div>
                        <h3>@request.Type #@request.Id</h3>
                        <p>Gửi lúc @request.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <span class="admin-pill">@request.Status</span>
                </div>
                <dl class="detail-list">
                    <dt>Liên hệ</dt><dd>@request.ContactName - @request.ContactPhone</dd>
                    <dt>Lý do</dt><dd>@request.Reason</dd>
                    <dt>Mô tả</dt><dd>@request.Description</dd>
                    <dt>Phương án mong muốn</dt><dd>@request.PreferredResolution</dd>
                    <dt>Sản phẩm</dt>
                    <dd>@(string.Join(", ", request.Items.Select(item => $"{item.ProductNameSnapshot} × {item.Quantity}")))</dd>
                </dl>
                @if (request.Images.Any())
                {
                    <div class="admin-support-images">
                        @foreach (var image in request.Images.OrderBy(image => image.SortOrder))
                        {
                            <a href="@image.ImageUrl" target="_blank" rel="noopener">
                                <img src="@image.ImageUrl" alt="Ảnh minh chứng yêu cầu #@request.Id" loading="lazy" decoding="async" />
                            </a>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

<section class="admin-panel">
    <div class="panel-head"><h2>Sản phẩm trong đơn</h2></div>
    <table class="admin-table">
        <thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0") ₫</td>
                    <td>@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</td>
                </tr>
            }
        </tbody>
    </table>
</section>
