@model UserOrdersViewModel
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    var isAdminViewer = User.IsInRole("Admin");
}

<section class="orders-page">
    <header class="orders-hero">
        <div>
            <span class="eyebrow">Tài khoản</span>
            <h1>Đơn hàng của tôi</h1>
            <p>Xem lại các đơn hàng đã đặt và thông tin chi tiết của từng đơn.</p>
        </div>
        @if (!isAdminViewer)
        {
            <a class="btn-ghost" asp-controller="Product" asp-action="Index">
                <i data-lucide="shopping-bag" aria-hidden="true"></i>
                Tiếp tục mua sắm
            </a>
        }
    </header>

    @if (!Model.Orders.Any())
    {
        <div class="orders-empty">
            <div class="orders-empty-icon"><i data-lucide="package-open" aria-hidden="true"></i></div>
            <h2>Bạn chưa có đơn hàng nào</h2>
            <p>Những đơn điện thoại của bạn sẽ xuất hiện tại đây sau khi đặt hàng.</p>
            @if (!isAdminViewer)
            {
                <a class="btn-primary" asp-controller="Product" asp-action="Index">Mua sắm ngay</a>
            }
        </div>
    }
    else
    {
        <div class="order-stack">
            @foreach (var order in Model.Orders)
            {
                var previewItems = order.Items.Take(2).ToList();
                var extraCount = Math.Max(0, order.Items.Count - previewItems.Count);
                var latestRequest = SprintFeatures.IsEnabled(2)
                    ? order.ReturnWarrantyRequests.OrderByDescending(request => request.CreatedAt).FirstOrDefault()
                    : null;
                <article class="order-card order-card-modern">
                    <div class="order-card-top">
                        <div>
                            <a class="order-code" asp-action="Detail" asp-route-id="@order.Id">#DH@(order.Id.ToString("D4"))</a>
                            <span>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <span class="order-status @StatusClass(order.Status)">@OrderStatusFilters.ToDisplayLabel(order.Status)</span>
                    </div>

                    <div class="order-card-body">
                        <div class="order-products-preview">
                            @foreach (var item in previewItems)
                            {
                                <div class="order-product-line">
                                    @if (!string.IsNullOrWhiteSpace(item.Product?.PrimaryImageUrl))
                                    {
                                        <img src="@item.Product.PrimaryImageUrl" alt="@item.Product.Name" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <div class="order-item-fallback"><i data-lucide="cpu" aria-hidden="true"></i></div>
                                    }
                                    <div>
                                        <strong>@(item.Product?.Name ?? "Sản phẩm đã ngừng bán")</strong>
                                        <span>Số lượng: @item.Quantity</span>
                                    </div>
                                </div>
                            }
                            @if (extraCount > 0)
                            {
                                <span class="order-more">+@extraCount sản phẩm khác</span>
                            }
                        </div>
                    </div>

                    <div class="order-card-bottom">
                        <div class="order-total">
                            <span>Tổng tiền</span>
                            <strong>@order.TotalAmount.ToString("N0") đ</strong>
                        </div>
                        <div class="order-actions">
                            <a class="btn-ghost" asp-action="Detail" asp-route-id="@order.Id">Xem chi tiết</a>
                            @if (SprintFeatures.IsEnabled(2))
                            {
                                @if (!isAdminViewer)
                                {
                                    <form asp-action="Reorder" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button class="btn-primary" type="submit">Mua lại</button>
                                    </form>
                                }
                                @if (!isAdminViewer && order.Status == OrderStatuses.Delivered && latestRequest is null)
                                {
                                    <a class="btn-ghost" asp-controller="ReturnWarranty" asp-action="Create" asp-route-orderId="@order.Id">Yêu cầu hỗ trợ</a>
                                }
                                @if (!isAdminViewer && string.Equals(order.PaymentMethod, "VNPAY", StringComparison.OrdinalIgnoreCase) && !order.IsPaid && (order.Status == OrderStatuses.AwaitingPayment || order.Status == OrderStatuses.Pending))
                                {
                                    <form asp-controller="Payment" asp-action="VnpayCreate" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button class="btn-primary" type="submit">Thanh toán VNPAY</button>
                                    </form>
                                }
                                @if (order.Status == OrderStatuses.AwaitingPayment || order.Status == OrderStatuses.Pending)
                                {
                                    <form asp-action="Cancel" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button class="btn-ghost danger" type="submit" onclick="return confirm('Huỷ đơn hàng #DH@(order.Id.ToString("D4"))?')">Huỷ đơn</button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="Phân trang đơn hàng">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="@(i == Model.CurrentPage ? "active" : "")" asp-action="History" asp-route-page="@i">@i</a>
                }
            </nav>
        }
    }
</section>

@functions {
    private static string StatusClass(string status)
    {
        if (status == OrderStatuses.AwaitingPayment) return "pending";
        if (status == OrderStatuses.Pending) return "pending";
        if (status == OrderStatuses.Confirmed) return "processing";
        if (status == OrderStatuses.Shipping) return "shipping";
        if (status == OrderStatuses.Delivered) return "completed";
        if (status == OrderStatuses.Cancelled) return "cancelled";
        return "pending";
    }
}
