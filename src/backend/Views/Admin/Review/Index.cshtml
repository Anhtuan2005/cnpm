@model IEnumerable<EcommerceApp.Models.Review>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Phản hồi đánh giá";
    var reviews = Model.ToList();
}

<section class="admin-panel">
    <div class="panel-head">
        <h2>Đánh giá của khách hàng</h2>
        <span>@reviews.Count đánh giá · Nội dung được công khai ngay khi khách gửi</span>
    </div>
    <table class="admin-table">
        <thead>
            <tr><th>Sản phẩm</th><th>Khách hàng</th><th>Đánh giá</th><th>Phản hồi của cửa hàng</th></tr>
        </thead>
        <tbody>
            @if (reviews.Count == 0)
            {
                <tr><td colspan="4">Chưa có đánh giá để phản hồi.</td></tr>
            }
            else
            {
                @foreach (var review in reviews)
                {
                    <tr>
                        <td>
                            <strong>@review.Product?.Name</strong>
                            <div>
                                <a class="admin-button secondary" href="/Product/Detail/@review.ProductId">
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                    Xem sản phẩm
                                </a>
                            </div>
                        </td>
                        <td>@(review.User?.FullName ?? review.User?.Email)<br /><small>@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></td>
                        <td>
                            <strong class="review-stars">@(new string('★', review.Rating))</strong>
                            <p class="review-comment">@review.Comment</p>
                            @if (review.Images.Count > 0)
                            {
                                <small>@review.Images.Count ảnh đính kèm</small>
                            }
                        </td>
                        <td>
                            @if (review.StoreRepliedAt.HasValue)
                            {
                                <p><strong>Đã phản hồi</strong> · @review.StoreRepliedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            }
                            <form asp-action="Reply" asp-route-id="@review.Id" method="post">
                                @Html.AntiForgeryToken()
                                <textarea name="reply" rows="3" maxlength="500" required placeholder="Viết phản hồi công khai, tối đa 500 ký tự">@review.StoreReply</textarea>
                                <button class="admin-button" type="submit">@(review.StoreReply is null ? "Đăng phản hồi" : "Cập nhật phản hồi")</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>
